# --- NEAR connection -------------------------------------------------------
# testnet
NEAR_NETWORK=testnet

# agentfence contract (deployed with request_spend -> MPC chain)
CONTRACT_ACCOUNT=agentfence-contract-evm-0b497ae1.testnet

# Owner account (writes policy via installed near CLI + keychain).
OWNER_ACCOUNT=agentfence-owner-9a9635f2.testnet

# NEAR Chain Signatures MPC contract (testnet).
MPC_ACCOUNT=v1.signer-prod.testnet

# Agent account that owns the function-call key.
AGENT_ACCOUNT=agentfence-agent-9a9635f2.testnet

# Path to the agent's function-call private key file (outside the repo).
# MUST be a function-call key for the CURRENT contract (receiver =
# CONTRACT_ACCOUNT, method_names = ["request_spend"]) - the on-chain key
# granting request_spend on agentfence-contract-evm-0b497ae1.testnet lives
# in agentfence-agent-fck-evm.txt, NOT agentfence-agent-fck.txt (that one
# targets an older contract and will be refused). Never commit it.
AGENT_FCK_KEY_FILE=~/.near-credentials/agentfence-agent-fck-evm.txt

# Sepolia EVM RPC (defaults to a public Sepolia RPC if unset).
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- LLM --------------------------------------------------------------------
# anthropic | openai | ollama (default: anthropic)
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model sent to the provider (always read from env, never hardcoded).
LLM_MODEL=replace-with-your-model
