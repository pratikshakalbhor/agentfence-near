{
  "name": "agentfence-cli",
  "version": "0.1.0",
  "description": "agentfence command-line tool (SDK for reads, near CLI for owner writes)",
  "type": "module",
  "bin": {
    "agentfence": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "agentfence-sdk": "file:../sdk",
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
